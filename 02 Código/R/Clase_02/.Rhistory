knitr::opts_chunk$set(
echo       = TRUE,
message    = FALSE,
warning    = FALSE,
fig.align  = "center",
fig.width  = 8,
fig.height = 5
)
# Instalación (descomentar si es necesario):
# install.packages(c("haven", "tidyverse", "stargazer", "car", "knitr", "kableExtra"))
library(haven)       # Leer archivos .dta (Stata)
library(tidyverse)   # Manipulación de datos y gráficos (dplyr, ggplot2, etc.)
library(stargazer)   # Tablas de regresión
library(car)         # Pruebas de hipótesis lineales (linearHypothesis)
library(knitr)       # Tablas y formato
library(kableExtra)  # Formato adicional para tablas
knitr::opts_chunk$set(
echo       = TRUE,
message    = FALSE,
warning    = FALSE,
fig.align  = "center",
fig.width  = 8,
fig.height = 5
)
library(tidyverse)
library(knitr)
library(kableExtra)
set.seed(42) # Fijamos semilla para reproducibilidad
n <- 50 # Tamaño de muestra
# Parámetros verdaderos
beta_true <- c(5, 2.5, 1.2)
sigma_true <- 3
# Variables independientes
educ  <- round(runif(n, min = 6, max = 22), 1)   # Años de educación
exper <- round(runif(n, min = 0, max = 30), 1)    # Años de experiencia
# Error aleatorio
epsilon <- rnorm(n, mean = 0, sd = sigma_true)
# Variable dependiente
salario <- beta_true[1] + beta_true[2] * educ + beta_true[3] * exper + epsilon
# Data frame
datos <- data.frame(salario, educ, exper)
head(datos, 10)
summary(datos)
ggplot(datos, aes(x = educ, y = salario)) +
geom_point(color = "steelblue", size = 2, alpha = 0.7) +
labs(title = "Salario vs. Años de Educación",
x = "Años de educación", y = "Salario (miles de pesos)") +
theme_minimal()
ggplot(datos, aes(x = exper, y = salario)) +
geom_point(color = "firebrick", size = 2, alpha = 0.7) +
labs(title = "Salario vs. Años de Experiencia",
x = "Años de experiencia", y = "Salario (miles de pesos)") +
theme_minimal()
# Vector Y
Y <- matrix(salario, ncol = 1)
# Matriz X (con columna de unos)
X <- cbind(1, educ, exper)
cat("Dimensiones de X:", dim(X), "\n")
cat("Dimensiones de Y:", dim(Y), "\n")
head(X)
head(Y)
XtX <- t(X) %*% X
XtX
# Verificamos simetría
all.equal(XtX, t(XtX))
XtY <- t(X) %*% Y
XtY
XtX_inv <- solve(XtX)  # Inversa de X'X
beta_hat <- XtX_inv %*% XtY
cat("Estimadores:\n")
cat("  β̂₀ (intercepto) =", round(beta_hat[1], 4), "\n")
cat("  β̂₁ (educación)  =", round(beta_hat[2], 4), "\n")
cat("  β̂₂ (experiencia)=", round(beta_hat[3], 4), "\n")
cat("\nParámetros verdaderos: β₀ =", beta_true[1],
", β₁ =", beta_true[2], ", β₂ =", beta_true[3], "\n")
eigen_vals <- eigen(XtX)$values
cat("Eigenvalores de X'X:", round(eigen_vals, 2), "\n")
cat("¿Todos positivos?", all(eigen_vals > 0), "\n")
Y_hat <- X %*% beta_hat     # Valores ajustados
e     <- Y - Y_hat           # Residuales
cat("Suma de residuales (debe ser ≈ 0):", round(sum(e), 10), "\n")
K_plus_1 <- ncol(X)  # Número de parámetros
gl <- n - K_plus_1   # Grados de libertad
sigma2_hat <- as.numeric(t(e) %*% e) / gl
cat("σ̂² =", round(sigma2_hat, 4), "\n")
cat("σ̂  =", round(sqrt(sigma2_hat), 4), "\n")
cat("σ verdadero =", sigma_true, "\n")
Var_beta <- sigma2_hat * XtX_inv
cat("Matriz de varianzas-covarianzas de β̂:\n")
round(Var_beta, 6)
se_beta <- sqrt(diag(Var_beta))
cat("Errores estándar:\n")
cat("  SE(β̂₀) =", round(se_beta[1], 4), "\n")
cat("  SE(β̂₁) =", round(se_beta[2], 4), "\n")
cat("  SE(β̂₂) =", round(se_beta[3], 4), "\n")
t_stats <- beta_hat / se_beta
p_vals  <- 2 * pt(abs(t_stats), df = gl, lower.tail = FALSE)
tabla_t <- data.frame(
Coeficiente = c("β̂₀ (Intercepto)", "β̂₁ (Educación)", "β̂₂ (Experiencia)"),
Estimado    = round(beta_hat, 4),
Error_Std   = round(se_beta, 4),
t_valor     = round(t_stats, 4),
p_valor     = round(p_vals, 6),
Significativo = ifelse(p_vals < 0.05, "Sí ✓", "No")
)
kable(tabla_t, col.names = c("Coeficiente", "Estimado", "Error Std.",
"t", "p-valor", "Sig. (5%)"),
align = "lccccc") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
t_stats <- beta_hat / se_beta
p_vals  <- 2 * pt(abs(t_stats), df = gl, lower.tail = FALSE)
tabla_t <- data.frame(
Coeficiente = c("β̂₀ (Intercepto)", "β̂₁ (Educación)", "β̂₂ (Experiencia)"),
Estimado    = round(beta_hat, 4),
Error_Std   = round(se_beta, 4),
t_valor     = round(t_stats, 4),
p_valor     = round(p_vals, 6),
Significativo = ifelse(p_vals < 0.05, "Sí ✓", "No")
)
kable(tabla_t, col.names = c("Coeficiente", "Estimado", "Error Std.",
"t", "p-valor", "Sig. (5%)"),
align = "lccccc") #%>%
#kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
t_stats <- beta_hat / se_beta
p_vals  <- 2 * pt(abs(t_stats), df = gl, lower.tail = FALSE)
tabla_t <- data.frame(
Coeficiente = c("β̂₀ (Intercepto)", "β̂₁ (Educación)", "β̂₂ (Experiencia)"),
Estimado    = round(beta_hat, 4),
Error_Std   = round(se_beta, 4),
t_valor     = round(t_stats, 4),
p_valor     = round(p_vals, 6),
Significativo = ifelse(p_vals < 0.05, "Sí ✓", "No")
)
kable(tabla_t, col.names = c("Coeficiente", "Estimado", "Error Std.",
"t", "p-valor", "Sig. (5%)"),
align = "lccccc") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
knitr::opts_chunk$set(
echo       = TRUE,
message    = FALSE,
warning    = FALSE,
fig.align  = "center",
fig.width  = 8,
fig.height = 5
)
# Instalación (descomentar si es necesario):
# install.packages(c("haven", "tidyverse", "stargazer", "car", "knitr", "kableExtra"))
library(haven)       # Leer archivos .dta (Stata)
library(tidyverse)   # Manipulación de datos y gráficos (dplyr, ggplot2, etc.)
library(stargazer)   # Tablas de regresión
library(car)         # Pruebas de hipótesis lineales (linearHypothesis)
library(knitr)       # Tablas y formato
library(kableExtra)  # Formato adicional para tablas
knitr::include_graphics("Hayashi_p62.png")
knitr::include_graphics("Nerlove.png")
# Lectura del archivo .dta
df <- read_dta("nerlove63.dta")
# Primeras observaciones
head(df)
# Últimas observaciones
tail(df)
summary(df)
# Estructura del data frame
str(df)
# Verificamos si hay datos faltantes
colSums(is.na(df))
df <- df %>%
mutate(
Ltotcost = log(totcost),
Loutput  = log(output),
Lplabor  = log(plabor),
Lpfuel   = log(pfuel),
Lpkap    = log(pkap),
avgcost  = totcost / output
)
head(df)
ggplot(df, aes(x = totcost)) +
geom_histogram(fill = "forestgreen", color = "white", bins = 20) +
labs(
title = "Histograma de Costo Total (MM USD)",
x     = "totcost (MM USD)",
y     = "Frecuencia"
) +
theme_minimal()
ggplot(df, aes(x = totcost)) +
geom_density(fill = "steelblue", alpha = 0.5) +
labs(
title = "Densidad de Costo Total (MM USD)",
x     = "totcost (MM USD)",
y     = "Densidad"
) +
theme_minimal()
ggplot(df, aes(x = output, y = avgcost)) +
geom_point(color = "red", size = 2, alpha = 0.7) +
labs(
title = "Dispersión: Output vs. Costo Promedio",
x     = "Output",
y     = "Costo Promedio"
) +
theme_minimal()
# Estimación por MCO
modelo <- lm(Ltotcost ~ Loutput + Lplabor + Lpfuel + Lpkap, data = df)
# Resultados detallados
summary(modelo)
stargazer(modelo,
type  = "html",
title = "Resultados de la Regresión: log(Costo Total)",
dep.var.labels = "ln(totcost)",
covariate.labels = c("ln(output)", "ln(plabor)", "ln(pfuel)", "ln(pkap)"),
digits = 4)
# Coeficientes estimados
coef(modelo)
# Estadísticos t
summary(modelo)$coefficients[, "t value"]
# Prueba F (equivalente al t^2 con 1 restricción)
linearHypothesis(modelo, "Lplabor + Lpfuel + Lpkap = 1")
# Extraemos los coeficientes
b <- coef(modelo)
suma_betas <- b["Lplabor"] + b["Lpfuel"] + b["Lpkap"]
# Varianza del estimador de la combinación lineal
vcov_modelo <- vcov(modelo)
R <- c(0, 0, 1, 1, 1)
se_suma <- sqrt(t(R) %*% vcov_modelo %*% R)
# Estadístico t
t_stat <- (suma_betas - 1) / se_suma
p_valor <- 2 * pt(abs(t_stat), df = modelo$df.residual, lower.tail = FALSE)
cat("Suma de coeficientes (β3 + β4 + β5):", round(suma_betas, 4), "\n")
cat("Error estándar:", round(se_suma, 4), "\n")
cat("Estadístico t:", round(t_stat, 4), "\n")
cat("p-valor:", round(p_valor, 4), "\n")
# Valor ajustado en logaritmos
df <- df %>%
mutate(
Ltotcost_hat = predict(modelo),
totcost_e    = exp(Ltotcost_hat),
avgcost_e    = totcost_e / output
)
head(df %>% select(output, avgcost, avgcost_e))
df %>%
select(avgcost, avgcost_e) %>%
summary()
ggplot(df, aes(x = output)) +
geom_point(aes(y = avgcost, color = "Observado"), size = 2, alpha = 0.7) +
geom_point(aes(y = avgcost_e, color = "Estimado"), size = 2, alpha = 0.7) +
scale_color_manual(
values = c("Observado" = "red", "Estimado" = "steelblue"),
name   = ""
) +
labs(
title = "Output vs. Costo Promedio: Observado y Estimado",
x     = "Output",
y     = "Costo Promedio"
) +
theme_minimal() +
theme(legend.position = "bottom")
